    <script>
        let currentSlide = 1;
        const totalSlides = 11;

        function showSlide(index) {
            document.querySelectorAll('.slide').forEach(s => s.classList.remove('active'));
            document.getElementById(`slide-${index}`).classList.add('active');
            
            // Animaciones específicas al cargar slides
            if(index === 2) drawVenn();
        }

        function nextSlide() {
            if (currentSlide < totalSlides) {
                currentSlide++;
                showSlide(currentSlide);
            }
        }

        function prevSlide() {
            if (currentSlide > 1) {
                currentSlide--;
                showSlide(currentSlide);
            }
        }

        // --- VISUALIZACIONES ---

        // 1. Venn Diagram
        function drawVenn() {
            const canvas = document.getElementById('vennCanvas');
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0,0,500,400);

            // Circle A
            ctx.globalAlpha = 0.6;
            ctx.fillStyle = '#27272A';
            ctx.beginPath();
            ctx.arc(200, 200, 140, 0, Math.PI * 2);
            ctx.fill();

            // Circle B
            ctx.fillStyle = '#FACC15';
            ctx.beginPath();
            ctx.arc(300, 200, 140, 0, Math.PI * 2);
            ctx.fill();

            ctx.globalAlpha = 1.0;
            ctx.fillStyle = 'white';
            ctx.font = 'bold 12px Inter';
            ctx.fillText('ENTRENAMIENTO GIMNASIO', 60, 200);
            ctx.fillText('COMPETICIÓN ATLÉTICA', 290, 200);

            ctx.fillStyle = 'black';
            ctx.font = '900 16px Inter';
            ctx.fillText('FITNESS RACING', 195, 205);
        }

        // 2. Growth Chart (Chart.js)
        const initCharts = () => {
            const ctxGrowth = document.getElementById('growthChart').getContext('2d');
            new Chart(ctxGrowth, {
                type: 'line',
                data: {
                    labels: ['2018', '2019', '2021', '2023', '2025/26'],
                    datasets: [{
                        label: 'Número de Atletas',
                        data: [650, 2000, 10000, 500000, 1000000],
                        borderColor: '#FACC15',
                        backgroundColor: 'rgba(250, 204, 21, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 4,
                        pointBackgroundColor: 'white'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { display: false },
                        x: { grid: { display: false }, ticks: { color: '#71717A' } }
                    }
                }
            });

            // 3. Cost vs Perception Chart
            const ctxCost = document.getElementById('costChart').getContext('2d');
            new Chart(ctxCost, {
                type: 'bar',
                data: {
                    labels: [['Inversión', 'Real'], ['Percepción', 'de Valor']],
                    datasets: [{
                        data: [200000, 2000000],
                        backgroundColor: ['#27272A', '#FACC15'],
                        borderRadius: 5
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ' €' + context.parsed.x.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        x: { display: false },
                        y: { 
                            grid: { display: false }, 
                            ticks: { color: 'white', font: { weight: 'bold' } } 
                        }
                    }
                }
            });
        };

        window.onload = initCharts;

        // Key listeners for classroom presentation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') nextSlide();
            if (e.key === 'ArrowLeft') prevSlide();
        });
    </script>

